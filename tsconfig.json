{
  "compilerOptions": {
    "target": "ES2023", "module": "NodeNext", "moduleResolution": "NodeNext",
    "strict": true, "noEmit": true, "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true, "erasableSyntaxOnly": true,
    "skipLibCheck": true, "lib": ["ES2023", "DOM"], "types": ["node"], "jsx": "react-jsx"
  },
  "include": ["packages/contracts/**/*.ts", "packages/hallmark-adapter/**/*.ts", "packages/core/**/*.ts", "packages/store/**/*.ts", "packages/presentation/**/*.ts", "packages/service/**/*.ts", "packages/dsh-plugin/**/*.ts", "packages/dsh-plugin/**/*.tsx", "test/**/*.ts"],
  "exclude": ["test/spike", "packages/dsh-plugin/lib"]
}
