{
  "name": "dsh-plugin-apps-bundle",
  "version": "1.0.0-candidate.70",
  "description": "Apps A.2 candidate: native chat references, verified component authoring and one companion Runtime",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client/client.js",
    "./runtime": "./lib/runtime.js",
    "./authoring/build": "./lib/apps-authoring-build.js",
    "./authoring/preview": "./lib/apps-authoring-preview.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "dsh-apps-authoring-build": "./lib/apps-authoring-build.js",
    "dsh-apps-authoring-preview": "./lib/apps-authoring-preview.js"
  },
  "files": [
    "lib",
    "client/client.js",
    "sdk",
    "source-starter",
    "authoring-docs",
    "skills",
    "cordis.patch.yml",
    "versions.json"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/schemastery": "3.18.4",
    "@deepseek-ai/dsh-tools": "0.2.0-rc.2",
    "@deepseek-ai/dsh-commands": "0.2.0-rc.2",
    "@deepseek-ai/dsh-agent": "0.2.0-rc.2",
    "@deepseek-ai/dsh-session-query": "0.2.0-rc.2",
    "@deepseek-ai/dsh-system-prompt": "0.2.0-rc.2"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-tool",
        "@deepseek-ai/dsh-client-ui-conversation"
      ],
      "external": [
        "react",
        "react/jsx-runtime",
        "react-dom",
        "react-dom/client"
      ]
    }
  }
}
