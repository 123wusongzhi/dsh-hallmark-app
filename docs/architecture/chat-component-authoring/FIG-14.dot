digraph FIG14 {
  graph [rankdir=TB, fontname="Microsoft YaHei", label="FIG-14 原聊天创作顺序 / A.1 目标"];
  node [shape=box, style="rounded,filled", fillcolor="#eef6ff", fontname="Microsoft YaHei"];
  edge [fontname="Microsoft YaHei"];
  S1 [label="01 用户 → 原输入框 / Host\n@ 选择应用：保留原会话 / 正文 / 附件"];
  S2 [label="02 原输入框 / Host → P2 Runtime\n核实真实 sessionId，绑定 appId + connectionId"];
  S1 -> S2 [label="顺序 / 非重复调用保证"];
  S3 [label="03 P2 Runtime → 原输入框 / Host\n真实绑定结果；失败或多连接时明确说明"];
  S2 -> S3 [label="顺序 / 非重复调用保证"];
  S4 [label="04 用户 → 原输入框 / Host\n用户手动发送创建 / 编辑要求"];
  S3 -> S4 [label="顺序 / 非重复调用保证"];
  S5 [label="05 原输入框 / Host → 原 DSH Agent\nDSH 正式输入：正文 / 应用引用 / 原附件"];
  S4 -> S5 [label="顺序 / 非重复调用保证"];
  S6 [label="06 原 DSH Agent → P2 Runtime\n可选：open_component(componentId, revision?)"];
  S5 -> S6 [label="顺序 / 非重复调用保证"];
  S7 [label="07 P2 Runtime → 原 DSH Agent\n本会话新 view 与独立 checkout 目录"];
  S6 -> S7 [label="顺序 / 非重复调用保证"];
  S8 [label="08 原 DSH Agent → 工程 / 真实预览\n新建 / 修改 TSX、CSS、绑定与依赖；实际构建"];
  S7 -> S8 [label="顺序 / 非重复调用保证"];
  S9 [label="09 工程 / 真实预览 → 原 DSH Agent\n同份 dist 的截图、运行错误与交互报告"];
  S8 -> S9 [label="顺序 / 非重复调用保证"];
  S10 [label="10 原 DSH Agent → 工程 / 真实预览\n不合格：继续修改、构建和预览；取消则停止"];
  S9 -> S10 [label="顺序 / 非重复调用保证"];
  S11 [label="11 原 DSH Agent → P2 Runtime\n通过：open_source_component(directory, viewId?)"];
  S10 -> S11 [label="顺序 / 非重复调用保证"];
  S12 [label="12 P2 Runtime → 原输入框 / Host\ncapture 成功后事务更新 build / view / 引用"];
  S11 -> S12 [label="顺序 / 非重复调用保证"];
  S13 [label="13 原输入框 / Host → 组件 frame / Client\n当前 session + view + build + 新 frame 握手加载"];
  S12 -> S13 [label="顺序 / 非重复调用保证"];
  S14 [label="14 组件 frame / Client → 原输入框 / Host\n实际展示检查：显示成功或保留最后可用版"];
  S13 -> S14 [label="顺序 / 非重复调用保证"];
  S15 [label="15 用户 → 原输入框 / Host\n原聊天继续反馈；或明确“保存到组件库”"];
  S14 -> S15 [label="顺序 / 非重复调用保证"];
  S16 [label="16 原输入框 / Host → 原 DSH Agent\n消费下一次原手动发送；修改回到步骤 8"];
  S15 -> S16 [label="顺序 / 非重复调用保证"];
  S17 [label="17 原 DSH Agent → P2 Runtime\n仅明确保存：save_as 或 update + expectedRevision"];
  S16 -> S17 [label="顺序 / 非重复调用保证"];
  S18 [label="18 P2 Runtime → 原 DSH Agent\n新 componentId / revision；或 COMPONENT_CONFLICT"];
  S17 -> S18 [label="顺序 / 非重复调用保证"];
  S10 -> S8 [style=dashed,label="不合格：新一轮修改 / 验证"];
  S16 -> S8 [style=dashed,label="原聊天反馈要求修改"];
}
